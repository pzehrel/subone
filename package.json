{
  "name": "subone",
  "version": "1.0.0",
  "private": true,
  "description": "Modern, lightweight subscription merger and template injector for Mihomo, Sing-box, and Loon",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.2 <25",
    "pnpm": ">=12.16.1 <13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:server": "pnpm --filter @subone/server dev",
    "dev:web": "pnpm --filter @subone/web dev",
    "build": "pnpm -r build",
    "build:server": "pnpm --filter @subone/server build",
    "build:web": "pnpm --filter @subone/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "start": "pnpm --filter @subone/server start"
  },
  "keywords": [
    "singbox",
    "mihomo",
    "clash",
    "loon",
    "subscription",
    "proxy"
  ],
  "author": {
    "name": "pzehrel",
    "email": "pzehrel@gmail.com",
    "url": "https://github.com/pzehrel"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pzehrel/subone.git"
  },
  "homepage": "https://github.com/pzehrel/subone#readme"
}
